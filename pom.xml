<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.plovdev.audiosnd</groupId>
    <artifactId>AudioSND</artifactId>
    <name>AudioSND</name>
    <version>${revision}</version>
    <description>AudioSND is a powerful low-latency audio engine for Java applications, implemented using JNI (Java
        Native Interface) for interaction with native C++ code. The project was created with the purpose of providing
        developers with a convenient tool for working with audio in high-performance applications such as games, media
        players, and music application
    </description>
    <url>https://github.com/plovdev/AudioSND</url>
    <packaging>pom</packaging>

    <licenses>
        <license>
            <name>The Unlicense</name>
            <url>https://unlicense.org</url>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>Anton</name>
            <email>ap67253100@gmail.com</email>
            <organization>PlovDev</organization>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/plovdev/AudioSND.git</connection>
        <developerConnection>scm:git:git@github.com:plovdev/AudioSND.git</developerConnection>
        <url>https://github.com/plovdev/AudioSND</url>
    </scm>

    <modules>
        <module>core</module>
        <module>implementation</module>
        <module>loaders</module>
        <module>generator</module>
        <module>examples</module>
        <module>effects</module>
        <module>profiler</module>
        <module>math</module>
    </modules>

    <properties>
        <revision>1.0.0-BETA-2</revision>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>

        <jb-annos.version>26.0.2</jb-annos.version>
        <jb-annos.scope>compile</jb-annos.scope>
        <slf4j.version>2.0.17</slf4j.version>
        <junit.version>6.0.3</junit.version>
        <junit.scope>test</junit.scope>
    </properties>

    <dependencies>
        <!-- JB Annos dependencies !-->
        <dependency>
            <groupId>org.jetbrains</groupId>
            <artifactId>annotations</artifactId>
            <version>${jb-annos.version}</version>
            <scope>${jb-annos.scope}</scope>
        </dependency>

        <!-- Logger dependencies !-->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>${slf4j.version}</version>
        </dependency>

        <!-- JUnit5 dependencies !-->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>${junit.scope}</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <compilerArgs>
                        <arg>-Xlint:deprecation</arg>
                    </compilerArgs>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <version>1.5.0</version>
                <configuration>
                    <updatePomFile>true</updatePomFile>
                    <flattenMode>resolveCiFriendliesOnly</flattenMode>
                    <flattenedPomFilename>target/.flattened-pom.xml</flattenedPomFilename>
                </configuration>
                <executions>
                    <execution>
                        <id>flatten</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>flatten</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>